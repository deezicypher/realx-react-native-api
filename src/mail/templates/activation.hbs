      <!-- Header -->
      <tr>
        <td style="padding:32px 40px; border-bottom:1px solid #eef0f4;">
          <table width="100%" role="presentation">
            <tr>
              <td>
                <div style="font-size:22px; font-weight:800; letter-spacing:-.5px;">
                  Realx
                </div>
              </td>
              <td align="right">
                <span style="font-size:12px; font-weight:600; color:#6b7280;">
                  WELCOME
                </span>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- Hero -->
      <tr>
        <td style="padding:52px 40px 32px;">

          <div style="display:inline-block; padding:7px 11px; background:#eef2ff; color:#4f46e5; border-radius:999px; font-size:12px; font-weight:700; letter-spacing:.3px; margin-bottom:20px;">
            ACCOUNT ACTIVATION
          </div>

          <h1 style="margin:0 0 18px; font-size:38px; line-height:1.1; letter-spacing:-1.5px; color:#111827;">
            You're almost<br />
            <span style="color:#4f46e5;">in.</span>
          </h1>

          <p style="margin:0; font-size:16px; line-height:1.7; color:#667085;">
            Hi {{name}},<br /><br />
            Thanks for joining Realx. Activate your account to finish setting things up and start using the app.
          </p>

        </td>
      </tr>

      <!-- CTA -->
      <tr>
        <td style="padding:0 40px 40px;">

          <a href="{{url}}"
            style="display:inline-block; padding:16px 28px; background:#111827; color:#ffffff; text-decoration:none; border-radius:10px; font-size:15px; font-weight:700; letter-spacing:-.1px;">
            Activate my account &nbsp;→
          </a>

          <p style="margin:18px 0 0; font-size:12px; line-height:1.6; color:#98a2b3;">
            This activation link expires in 1 hour.
          </p>

        </td>
      </tr>

      <!-- Divider -->
      <tr>
        <td style="padding:0 40px;">
          <div style="height:1px; background:#eef0f4;"></div>
        </td>
      </tr>

      <!-- Benefits -->
      <tr>
        <td style="padding:34px 40px 40px;">

          <p style="margin:0 0 22px; font-size:13px; font-weight:700; color:#344054; text-transform:uppercase; letter-spacing:.7px;">
            Once you're in
          </p>

          <table width="100%" cellpadding="0" cellspacing="0" role="presentation">

            <tr>
              <td width="42" valign="top">
                <div style="width:32px; height:32px; background:#f2f4f7; border-radius:8px; text-align:center; line-height:32px; font-size:15px;">
                  ✓
                </div>
              </td>
              <td style="padding-bottom:20px;">
                <strong style="font-size:14px; color:#1d2939;">Complete your profile</strong>
                <div style="margin-top:4px; font-size:13px; line-height:1.5; color:#667085;">
                  Personalize your experience in just a few steps.
                </div>
              </td>
            </tr>

            <tr>
              <td width="42" valign="top">
                <div style="width:32px; height:32px; background:#f2f4f7; border-radius:8px; text-align:center; line-height:32px; font-size:15px;">
                  ✦
                </div>
              </td>
              <td style="padding-bottom:20px;">
                <strong style="font-size:14px; color:#1d2939;">Explore Realx</strong>
                <div style="margin-top:4px; font-size:13px; line-height:1.5; color:#667085;">
                  Discover the features built to help you get more done.
                </div>
              </td>
            </tr>

            <tr>
              <td width="42" valign="top">
                <div style="width:32px; height:32px; background:#f2f4f7; border-radius:8px; text-align:center; line-height:32px; font-size:15px;">
                  →
                </div>
              </td>
              <td>
                <strong style="font-size:14px; color:#1d2939;">Get started</strong>
                <div style="margin-top:4px; font-size:13px; line-height:1.5; color:#667085;">
                  Your account is ready when you are.
                </div>
              </td>
            </tr>

          </table>

        </td>
      </tr>

      <!-- Fallback -->
      <tr>
        <td style="padding:24px 40px; background:#fafafa; border-top:1px solid #eef0f4;">
